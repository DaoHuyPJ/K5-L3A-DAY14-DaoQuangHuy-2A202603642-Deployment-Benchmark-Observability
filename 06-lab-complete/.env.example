# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================

# Server — PORT do platform (Railway/Render) cấp khi deploy
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret — bắt buộc. Rỗng thì mọi request /ask bị 401.
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis cho rate limit + cost guard (docker compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Ngân sách chi phí LLM (USD, reset theo ngày / tháng UTC)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
